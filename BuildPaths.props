<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="SharedBuildPaths">
    <SolutionDir Condition="'$(SolutionDir)'=='' Or '$(SolutionDir)'=='*Undefined*' Or '$(SolutionDir)'=='$(ProjectDir)'">$(MSBuildThisFileDirectory)</SolutionDir>
    <RizeBuildRoot>$(SolutionDir)bin\</RizeBuildRoot>
    <OutDir>$(RizeBuildRoot)$(Configuration)\</OutDir>
    <IntDir>$(RizeBuildRoot)Intermediate\$(ProjectName)\$(Configuration)\</IntDir>
  </PropertyGroup>
</Project>
